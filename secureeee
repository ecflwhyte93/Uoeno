              label="Username"
              placeholder="Choose a username"
              value={username}
              onChangeText={setUsername}
              editable={!isLoading}
            />

            <AuthInput
              label="Email"
              placeholder="Enter your email"
              value={email}
              onChangeText={setEmail}
              editable={!isLoading}
            />

            <AuthInput
              label="Password"
              placeholder="Create a strong password"
              value={password}
              onChangeText={setPassword}
              secureTextEntry
              editable={!isLoading}
            />

