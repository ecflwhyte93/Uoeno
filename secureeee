 * Message encryption/decryption for SecureChat
 * Implements hybrid encryption: RSA for key exchange, AES-256-GCM for message encryption
 */

import * as crypto from "crypto";

export interface EncryptedMessage {
  encryptedMessage: string; // Base64-encoded AES-256-GCM ciphertext
  encryptedAesKey: string; // Base64-encoded RSA-encrypted AES key
  iv: string; // Base64-encoded IV
  authTag: string; // Base64-encoded authentication tag
}

/**
 * Encrypt a message for a recipient
 * 1. Generate random AES-256 key
 * 2. Encrypt message with AES-256-GCM
 * 3. Encrypt AES key with recipient's RSA public key
 */
export function encryptMessageForRecipient(
  plaintext: string,
  recipientPublicKeyPem: string
): EncryptedMessage {
  // Generate random AES-256 key and IV
  const aesKey = crypto.randomBytes(32);
  const iv = crypto.randomBytes(16);

  // Encrypt message with AES-256-GCM
  const cipher = crypto.createCipheriv("aes-256-gcm", aesKey, iv);
  let encryptedMessage = cipher.update(plaintext, "utf8", "hex");
  encryptedMessage += cipher.final("hex");
  const authTag = cipher.getAuthTag();

  // Encrypt AES key with RSA public key
  const encryptedAesKey = crypto.publicEncrypt(
    {
      key: recipientPublicKeyPem,
      padding: crypto.constants.RSA_PKCS1_OAEP_PADDING,
      oaepHash: "sha256",
    },
    aesKey
  );

  return {
    encryptedMessage: Buffer.from(encryptedMessage, "hex").toString("base64"),
    encryptedAesKey: encryptedAesKey.toString("base64"),
    iv: iv.toString("base64"),
    authTag: authTag.toString("base64"),
  };
}

/**
 * Decrypt a message using recipient's private key
 * 1. Decrypt AES key with RSA private key
 * 2. Decrypt message with AES-256-GCM
 */
export function decryptMessage(
  encrypted: EncryptedMessage,
  privateKeyPem: string
): string {
  // Decrypt AES key with RSA private key
  const encryptedAesKeyBuffer = Buffer.from(encrypted.encryptedAesKey, "base64");
  const aesKey = crypto.privateDecrypt(
    {
      key: privateKeyPem,
      padding: crypto.constants.RSA_PKCS1_OAEP_PADDING,
      oaepHash: "sha256",
    },
    encryptedAesKeyBuffer
  );

  // Decrypt message with AES-256-GCM
  const iv = Buffer.from(encrypted.iv, "base64");
  const authTag = Buffer.from(encrypted.authTag, "base64");
  const encryptedMessageBuffer = Buffer.from(encrypted.encryptedMessage, "base64");

  const decipher = crypto.createDecipheriv("aes-256-gcm", aesKey, iv);
  decipher.setAuthTag(authTag);

  let decrypted = decipher.update(encryptedMessageBuffer, undefined, "utf8");
  decrypted += decipher.final("utf8");

  return decrypted;
}

/**
 * Serialize encrypted message to JSON string for storage/transmission
 */
export function serializeEncryptedMessage(encrypted: EncryptedMessage): string {
  return JSON.stringify(encrypted);
}

/**
 * Deserialize encrypted message from JSON string
 */
export function deserializeEncryptedMessage(json: string): EncryptedMessage {
  return JSON.parse(json);
